@{
    ViewData["Title"] = "Sınav Sonuçlarım";
}

<div class="container-fluid mt-4">
    <h1 class="h3 mb-4 text-gray-800">
        <i class="fas fa-poll mr-2 text-primary"></i> Sınav Sonuçlarım
    </h1>

    <div class="card shadow mb-4 border-left-primary">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-primary">Tamamladığım Sınavlar</h6>
        </div>
        <div class="card-body bg-light">
            <div class="table-responsive">
                <table class="table table-bordered table-hover bg-white" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Sınav No (Exam ID)</th>
                            <th>Soru No</th>
                            <th>Seçilen Şık ID</th>
                        </tr>
                    </thead>
                    <tbody id="resultsBody">
                        <tr>
                            <td colspan="3" class="text-center font-weight-bold text-info">
                                <i class="fas fa-spinner fa-spin mr-2"></i> Veriler yükleniyor, lütfen bekleyin...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Geçici olarak token kontrolünü kaldırıyoruz veya esnetiyoruz
            // const token = localStorage.getItem('token');

            $.ajax({
                // İŞTE BÜYÜK DEĞİŞİKLİK BURADA: DOĞRU URL'YE GİDİYORUZ
                url: 'https://localhost:7028/api/StudentExam/MyResults',
                type: 'GET',
                contentType: 'application/json',
                // headers: { 'Authorization': 'Bearer ' + token }, // 401 hatası olmasın diye kapattık
                success: function (data) {
                    console.log("Gelen Veri:", data);
                    let rows = '';

                    if (!data || data.length === 0) {
                        rows = '<tr><td colspan="3" class="text-center text-danger font-weight-bold">Henüz çözülmüş bir sınavınız bulunmuyor.</td></tr>';
                    } else {
                        // API'den gelen camelCase (küçük harf) verilere göre güncelledik
                        $.each(data, function (index, item) {
                            rows += `<tr>
                                <td class="font-weight-bold text-primary"># ${item.examId}</td>
                                <td>${item.questionId}</td>
                                <td><span class="badge badge-success p-2" style="font-size:14px;">${item.selectedOptionId}</span></td>
                            </tr>`;
                        });
                    }
                    $('#resultsBody').html(rows);
                },
                error: function (xhr) {
                    console.error("Hata Detayı:", xhr.responseText);
                    $('#resultsBody').html(`<tr><td colspan="3" class="text-center text-danger font-weight-bold">
                        Veriler çekilemedi. Hata Kodu: ${xhr.status}
                    </td></tr>`);
                }
            });
        });
    </script>
}