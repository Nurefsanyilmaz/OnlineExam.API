@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Giriş Yap - Akdeniz Sınav Portalı</title>

    
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        .loading-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255,255,255,0.8);
            z-index: 9999;
            text-align: center;
            padding-top: 20%;
        }

        .card {
            border-radius: 15px;
        }

        .btn-user {
            border-radius: 10px;
            padding: 12px;
        }
    </style>
</head>

<body class="bg-gradient-primary">

    
    <div class="loading-overlay" id="loader">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 font-weight-bold text-primary">Bilgiler doğrulanıyor, lütfen bekleyin...</p>
    </div>

    <div class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-xl-5 col-lg-6 col-md-8 mt-5">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="p-5">
                            <div class="text-center">
                                <h1 class="h4 text-gray-900 mb-4">
                                    <i class="fas fa-graduation-cap fa-2x text-primary mb-3"></i><br>
                                    <strong>Akdeniz Sınav Portalı</strong>
                                </h1>
                            </div>

                            
                            <form class="user" id="loginForm">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-user" id="txtUsername"
                                           placeholder="Kullanıcı Adı" required>
                                </div>
                                <div class="form-group">
                                    <input type="password" class="form-control form-control-user" id="txtPassword"
                                           placeholder="Şifre" required>
                                </div>
                                <button type="submit" id="btnGiris" class="btn btn-primary btn-user btn-block font-weight-bold">
                                    <i class="fas fa-sign-in-alt mr-2"></i> Güvenli Giriş Yap
                                </button>
                            </form>

                            <hr>

                            
                            <div class="text-center">
                                <a class="small font-weight-bold" href="/Home/Register">
                                    <i class="fas fa-user-plus mr-1"></i> Yeni Hesap Oluştur (Öğrenci Kaydı)
                                </a>
                            </div>
                            <div class="text-center mt-2">
                                <small class="text-muted">Şifrenizi unuttuysanız sistem yöneticisi ile iletişime geçiniz.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            $("#loginForm").submit(function (e) {
                e.preventDefault();
                $("#loader").show();

                var loginData = {
                    username: $("#txtUsername").val(),
                    password: $("#txtPassword").val()
                };

                
                $.ajax({
                    url: 'https://localhost:7028/api/Auth/Login',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(loginData),
                    success: function (response) {

                        localStorage.setItem('token', response.token);
                        localStorage.setItem('userRole', response.role);
                        localStorage.setItem('userName', response.userName);

                        
                        $.ajax({
                            url: '/Home/CreateSession',
                            type: 'POST',
                            data: {
                                username: response.userName,
                                role: response.role
                            },
                            success: function () {
                                $("#loader").hide();

                                
                                if (response.role === "Admin") {
                                    alert("Hoş geldiniz Sayın Panel Yöneticisi!");
                                    window.location.href = '/Admin/ExamList';
                                } else {
                                    alert("Giriş başarılı! Sınavlarında başarılar dileriz, " + response.userName);
                                    window.location.href = '/Home/Index';
                                }
                            },
                            error: function () {
                                $("#loader").hide();
                                alert("Oturum senkronizasyonu sırasında bir hata oluştu!");
                            }
                        });
                    },
                    error: function (xhr) {
                        $("#loader").hide();
                        alert("Giriş Başarısız! Kullanıcı adı veya şifre hatalı.");
                        console.error("API Hatası Detayı:", xhr.responseText);
                    }
                });
            });
        });
    </script>
</body>
</html>